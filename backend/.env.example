# CivicResolve environment contract.
#
# Every operational threshold lives here. Nothing in app/ hardcodes a tunable
# value. Copy to .env and fill secrets. The .env file is git-ignored and must
# never be committed; this example file is the committed source of truth.
#
# All application variables carry the CIVIC_ prefix to avoid collisions with
# host environment variables. Provider credentials keep their conventional names.

# Application
CIVIC_APP_NAME=CivicResolve
CIVIC_ENVIRONMENT=development
CIVIC_DEBUG=true
CIVIC_SERVICE_NAME=civicresolve-api
CIVIC_API_PREFIX=/api

# Server
CIVIC_HOST=127.0.0.1
CIVIC_PORT=8000
# Comma-separated. Parsed by Settings, not by the JSON loader.
CIVIC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
CIVIC_LOG_LEVEL=INFO
# Pretty console output in development; set true for structured JSON in deployment.
CIVIC_LOG_JSON=false

# Database. SQLite in WAL mode for the prototype. Swapping to Postgres is a URL
# change plus a driver dependency; no application code changes.
CIVIC_DATABASE_URL=sqlite+aiosqlite:///./civicresolve.db
CIVIC_DB_ECHO=false

# Agent runtime. Selects the implementation behind app.agents.ports without any
# other code change. Start on direct; adk and langgraph are drop-in alternatives.
CIVIC_AGENT_RUNTIME=direct
CIVIC_AUDITOR_MAX_TOOL_CALLS=6

# Gemini. Set the model identifiers your key actually serves.
GEMINI_API_KEY=
CIVIC_TRIAGE_MODEL=gemini-2.5-flash
CIVIC_FORENSICS_MODEL=gemini-2.5-pro
CIVIC_FALLBACK_MODEL=gemini-2.5-flash-lite
CIVIC_GEMINI_TEMPERATURE=0.0
CIVIC_TRIAGE_TIMEOUT_S=10
CIVIC_FORENSICS_TIMEOUT_S=25
CIVIC_GEMINI_MAX_RETRIES=3
# Hard ceiling on paid calls per rolling day. A public deployment with a public
# repository is an abuse target; this cap is the blast-radius limit.
CIVIC_GEMINI_DAILY_CAP=500
CIVIC_BREAKER_THRESHOLD=5
CIVIC_BREAKER_RESET_S=60

# Forensics thresholds. These values reproduce the worked example in fixtures.
CIVIC_GEO_TOLERANCE_M=50
CIVIC_MIN_REPAIR_MINUTES=120
CIVIC_MIN_REPAIR_FLOOR=15
CIVIC_MIN_REPAIR_CEILING=10080
CIVIC_PHASH_THRESHOLD=8
CIVIC_DUP_COSINE_THRESHOLD=0.92
CIVIC_MAX_INCONCLUSIVE=1
CIVIC_VISUAL_MIN_CONFIDENCE=0.55

# Priority weighting. The three weights must sum to 1.0; startup fails otherwise.
CIVIC_W_URGENCY=0.45
CIVIC_W_IMPACT=0.30
CIVIC_W_HISTORY=0.25
CIVIC_ESCALATE_REOPENS=2
CIVIC_ESCALATE_FAILED_CLOSURES=3

# Citizen response SLA. Production is 72 hours. Demo mode compresses it to 60
# seconds so escalation can be shown live on stage.
CIVIC_SLA_SECONDS=259200
CIVIC_DEMO_SLA_SECONDS=60
CIVIC_USE_DEMO_SLA=true
CIVIC_SCHEDULER_TICK_S=5
CIVIC_REOPEN_WINDOW_DAYS=30

# Closure acceptance quorum for assets with multiple reporters.
CIVIC_QUORUM_SIZE=2
CIVIC_QUORUM_RADIUS_M=50

# Request hardening
CIVIC_RATE_LIMIT_PER_MIN=30
CIVIC_RATE_LIMIT_BURST=10
CIVIC_IDEMPOTENCY_TTL_S=86400
CIVIC_MAX_UPLOAD_MB=12
CIVIC_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/heic

# Evidence storage. Originals are preserved byte-for-byte; only derived previews
# are re-encoded. Re-encoding an original would destroy the EXIF the audit needs.
CIVIC_UPLOAD_DIR=./uploads
CIVIC_THUMBNAIL_MAX_PX=1600
CIVIC_JPEG_QUALITY=82

# Notifications
CIVIC_SSE_HEARTBEAT_S=15
CIVIC_OUTBOX_POLL_S=1.0
CIVIC_EMAIL_ENABLED=false
RESEND_API_KEY=
CIVIC_EMAIL_FROM=CivicResolve <noreply@example.com>

# Demo behaviour. All three are forced off when CIVIC_ENVIRONMENT=production.
CIVIC_SEED_ON_STARTUP=true
CIVIC_DEMO_RESET_ENABLED=true